{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Learn: current lesson",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/course.ps1"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Emulator: build",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/dev.ps1", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Emulator: run",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/dev.ps1", "run"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Emulator: test",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/dev.ps1", "test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Emulator: watch tests on save",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/dev.ps1", "watch"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "C# scratchpad: run",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/dev.ps1", "lab"],
      "problemMatcher": "$msCompile"
    }
  ]
}
